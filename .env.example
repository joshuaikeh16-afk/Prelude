NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Prelude push notifications
CRON_SECRET=replace-with-a-long-random-secret
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key
VAPID_SUBJECT=mailto:you@example.com
VAPID_PUBLIC_KEY=generated-vapid-public-key
VAPID_PRIVATE_KEY=generated-vapid-private-key

# HTML frontend origins allowed to call the API
PRELUDE_FRONTEND_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080,http://127.0.0.1:8080
RESEND_API_KEY=your-resend-key
RESEND_FROM=Prelude <hello@your-verified-domain.com>
EMAIL_OTP_SECRET=replace-with-a-long-random-secret
GEOAPIFY_API_KEY=your-server-side-geoapify-key
# Optional: full national holiday feed, including Nigerian lunar and observed dates
CALENDARIFIC_API_KEY=your-calendarific-key

# Gmail import (server-only). Enable Gmail API and configure OAuth read-only scope.
GMAIL_CLIENT_ID=your-google-web-oauth-client-id
GMAIL_CLIENT_SECRET=your-google-web-oauth-client-secret
GMAIL_REDIRECT_URI=http://localhost:3000/api/mail/callback
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MAIL_TOKEN_ENCRYPTION_KEY=base64-encoded-32-byte-key
